" .ideavimrc is a configuration file for IdeaVim plugin. It uses
"   the same commands as the original .vimrc configuration.
" You can find a list of commands here: https://jb.gg/h38q75
" Find more examples here: https://jb.gg/share-ideavimrc


"" -- Suggested options --
" Show a few lines of context around the cursor. Note that this makes the
" text scroll if you mouse-click near the start or end of the window.
set scrolloff=5

" Do incremental searching.
set incsearch

" Don't use Ex mode, use Q for formatting.
map Q gq

" Highlight copied text
set highlightedyank
" Commentary
set commentary



"" ---- SKR
"" Clipbaord
set clipboard=unnamedplus
set clipboard^=ideaput


set ReplaceWithRegister
xmap p gr
set surround

" Linenumber
set number
set relativenumber

"" Keymap
" set <leader> to <space>
let mapleader = " "

" Map <leader>d to start debug
map <leader>d <Action>(Debug)

" Map \b to toggle the breakpoint on the current line
map <leader>b <Action>(ToggleLineBreakpoint)

nmap ö <Action>(NextTab)
nmap Ö <Action>(PreviousTab)

"" -- Refactoring
nmap <leader>ri <Action>(Inline)
nmap <leader>rr <Action>(RenameElement)
nmap <leader>rev <Action>(IntroduceVariable)
nmap <leader>rem <Action>(ExtractMethod)
nmap <leader>rep <Action>(IntroduceParameter)
nmap <leader>rm <Action>(Move)
nmap <leader>ro <Action>(OptimizeImports)
nmap <leader>rG <Action>(Generate)

"" -- Formatting
nmap <leader>f  <Action>(ReformatCode)

"" -- Add mappings for Bookmarks
nmap <leader>mt <Action>(ToggleBookmark)
nmap <leader>ms <Action>(ShowBookmarks)

"" -- Navigation
nmap <leader>e <Action>(GotoFile)
nmap <leader>a <Action>(FindInPath)
nmap gr <Action>(ShowUsages)
nmap gi <Action>(GotoImplementation)
nmap gs <Action>(GotoSuperMethod)

"" -- Test
nmap <leader>rt <Action>(RunClass)
nmap <leader>dt <Action>(DebugClass)

"" -- IDE Actions
nmap <leader>o <Action>(SelectInProjectView)
"" nmap <leader>z <Action>(ToggleZenMode)
nmap <leader>z <Action>(ToggleDistractionFreeMode)
nmap <leader>se <Action>(ShowErrorDescription)
nmap <leader>p <Action>(TogglePresentationMode)
nmap <leader>q <Action>(ActivateTerminalToolWindow)
nmap <leader>sw <Action>(EditorToggleUseSoftWraps)
nmap <leader>mr <Action>(ReloadAllMavenProjects)

"" -- Debugging
nmap <leader>dc <Action>(Resume)
nmap <leader>dn <Action>(StepOver)
nmap <leader>di <Action>(StepInto)
nmap <leader>do <Action>(StepOut)
nmap <leader>dm <Action>(XDebugger.MuteBreakpoints)

"" Windows
nmap <leader>wv <Action>(SplitVertically)
nmap <leader>wh <Action>(SplitHorizontally)
nmap <leader>wc <Action>(Unsplit)
nmap <leader>ww <Action>(NextSplitter)

"" Tabs
nmap <leader>tmr <Action>(MoveTabRight)
nmap <leader>tml <Action>(MoveTabLeft)
nmap <leader>tmd <Action>(MoveTabDown)
nmap <leader>tmu <Action>(MoveTabUp)
nmap <leader>tmo <Action>(MoveEditorToOppositeTabGroup)
nmap <leader>tco <Action>(CloseAllEditorsButActive)
